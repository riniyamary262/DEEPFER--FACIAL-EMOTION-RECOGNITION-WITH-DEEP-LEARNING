# Create data generators
def create_generator(X, y, batch_size=32, augment=False):
    """Create a data generator with optional augmentation"""
    from tensorflow.keras.preprocessing.image import ImageDataGenerator
    
    if augment:
        datagen = ImageDataGenerator(
            rotation_range=30,
            width_shift_range=0.2,
            height_shift_range=0.2,
            shear_range=0.2,
            zoom_range=0.2,
            horizontal_flip=True,
            brightness_range=[0.8, 1.2]
        )
    else:
        datagen = ImageDataGenerator()
    
    return datagen.flow(X, y, batch_size=batch_size)

# Create generators
train_generator = create_generator(X_train_split, y_train_split, batch_size=32, augment=True)
validation_generator = create_generator(X_val_split, y_val_split, batch_size=32, augment=False)
test_generator = create_generator(X_test, y_test, batch_size=32, augment=False)

