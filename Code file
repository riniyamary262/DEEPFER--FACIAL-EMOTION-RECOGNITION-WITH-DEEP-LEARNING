def find_data_paths():
    """Automatically find train and test paths"""
    emotions = ['angry', 'disgust', 'fear', 'happy', 'neutral', 'sad', 'surprise']
    
    # Possible paths to check
    possible_paths = [
        'archive-3/archive-3/train',
        'archive-3/train',
        './archive-3/archive-3/train',
        './archive-3/train',
        '../archive-3/archive-3/train',
        '../archive-3/train',
        'archive-3/archive-3/test',
        'archive-3/test',
        './archive-3/archive-3/test',
        './archive-3/test',
        '../archive-3/archive-3/test',
        '../archive-3/test',
    ]
    
    train_path = None
    test_path = None
    
    # Check explicit paths first
    for path in possible_paths:
        if 'train' in path and os.path.exists(path):
            # Check if it contains emotion folders
            try:
                contents = os.listdir(path)
                if any(emotion in contents for emotion in emotions):
                    train_path = path
                    print(f"Found training data at: {path}")
                    break
            except:
                pass
        elif 'test' in path and os.path.exists(path):
            try:
                contents = os.listdir(path)
                if any(emotion in contents for emotion in emotions):
                    test_path = path
                    print(f"Found test data at: {path}")
                    break
            except:
                pass
    
    # If not found, search recursively
    if train_path is None or test_path is None:
        print("\nSearching recursively for data folders...")
        for root, dirs, files in os.walk('.'):
            if 'train' in dirs and train_path is None:
                train_candidate = os.path.join(root, 'train')
                try:
                    contents = os.listdir(train_candidate)
                    if any(emotion in contents for emotion in emotions):
                        train_path = train_candidate
                        print(f"Found training data at: {train_path}")
                except:
                    pass
            if 'test' in dirs and test_path is None:
                test_candidate = os.path.join(root, 'test')
                try:
                    contents = os.listdir(test_candidate)
                    if any(emotion in contents for emotion in emotions):
                        test_path = test_candidate
                        print(f"Found test data at: {test_path}")
                except:
                    pass
    
    return train_path, test_path

