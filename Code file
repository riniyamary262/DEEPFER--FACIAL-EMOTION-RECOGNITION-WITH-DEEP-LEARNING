def plot_sample_images_grid(X, y, emotions, samples_per_class=3):
    """
    Display sample images for each emotion class
    """
    if len(X) == 0:
        print("No images available to display")
        return
    
    fig, axes = plt.subplots(len(emotions), samples_per_class, 
                             figsize=(samples_per_class*3, len(emotions)*3))
    
    for i, emotion in enumerate(emotions):
        # Get indices for this class
        class_indices = np.where(y == i)[0]
        
        if len(class_indices) == 0:
            # If no images for this class, show blank
            for j in range(samples_per_class):
                if len(emotions) == 1:
                    ax = axes[j]
                else:
                    ax = axes[i, j]
                ax.text(0.5, 0.5, 'No images', ha='center', va='center')
                ax.axis('off')
            continue
            
        # Select random samples
        selected = np.random.choice(class_indices, 
                                   min(samples_per_class, len(class_indices)), 
                                   replace=False)
        
        for j, idx in enumerate(selected):
            if len(emotions) == 1:
                ax = axes[j]
            else:
                ax = axes[i, j]
            
            ax.imshow(X[idx].reshape(48, 48), cmap='gray')
            ax.set_title(emotion, fontsize=10)
            ax.axis('off')
        
        # Fill remaining subplots with blank
        for j in range(len(selected), samples_per_class):
            if len(emotions) == 1:
                ax = axes[j]
            else:
                ax = axes[i, j]
            ax.axis('off')
    
    plt.suptitle('Sample Images by Emotion Class', fontsize=16, fontweight='bold')
    plt.tight_layout()
    plt.show()



