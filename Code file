def plot_dimensionality_reduction(X, y, emotions, n_samples=1000):
    """
    Visualize data in 2D using PCA and t-SNE
    """
    if len(X) == 0:
        print("No images available for dimensionality reduction")
        return
    
    # Sample data if too many points
    if len(X) > n_samples:
        indices = np.random.choice(len(X), n_samples, replace=False)
        X_sample = X[indices]
        y_sample = y[indices]
    else:
        X_sample = X
        y_sample = y
    
    # Flatten images
    X_flat = X_sample.reshape(len(X_sample), -1)
    
    # Standardize the data
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X_flat)
    
    fig, axes = plt.subplots(1, 2, figsize=(15, 6))
    
    # 5.1 PCA
    print("Computing PCA...")
    try:
        pca = PCA(n_components=2, random_state=42)
        X_pca = pca.fit_transform(X_scaled)
        
        scatter = axes[0].scatter(X_pca[:, 0], X_pca[:, 1], c=y_sample, 
                                  cmap='tab10', alpha=0.6, s=30)
        axes[0].set_title('PCA Visualization', fontsize=14, fontweight='bold')
        axes[0].set_xlabel(f'First Principal Component (Explained Variance: {pca.explained_variance_ratio_[0]:.2%})', 
                          fontsize=12)
        axes[0].set_ylabel(f'Second Principal Component (Explained Variance: {pca.explained_variance_ratio_[1]:.2%})', 
                          fontsize=12)
        
        # Create legend
        legend_elements = [plt.Line2D([0], [0], marker='o', color='w', 
                                      markerfacecolor=plt.cm.tab10(i/len(emotions)), 
                                      label=emotions[i], markersize=10) 
                           for i in range(len(emotions))]
        axes[0].legend(handles=legend_elements, loc='best')
        
        # Print explained variance
        print("\n" + "="*60)
        print("PCA EXPLAINED VARIANCE")
        print("="*60)
        print(f"First component: {pca.explained_variance_ratio_[0]:.2%}")
        print(f"Second component: {pca.explained_variance_ratio_[1]:.2%}")
        print(f"Total explained: {sum(pca.explained_variance_ratio_):.2%}")
        
    except Exception as e:
        axes[0].text(0.5, 0.5, f'PCA failed: {str(e)[:50]}...', 
                    ha='center', va='center')
        axes[0].set_title('PCA Visualization (Failed)', fontsize=14, fontweight='bold')
        print(f"PCA Error: {e}")
    
    # 5.2 t-SNE
    print("\nComputing t-SNE (this may take a moment)...")
    try:
        # Use smaller sample for t-SNE if needed
        if len(X_scaled) > 1000:
            tsne_indices = np.random.choice(len(X_scaled), 1000, replace=False)
            X_tsne_data = X_scaled[tsne_indices]
            y_tsne_data = y_sample[tsne_indices]
        else:
            X_tsne_data = X_scaled
            y_tsne_data = y_sample
        
        tsne = TSNE(n_components=2, random_state=42, perplexity=30, n_iter=1000)
        X_tsne = tsne.fit_transform(X_tsne_data)
        
        scatter = axes[1].scatter(X_tsne[:, 0], X_tsne[:, 1], c=y_tsne_data, 
                                  cmap='tab10', alpha=0.6, s=30)
        axes[1].set_title('t-SNE Visualization', fontsize=14, fontweight='bold')
        axes[1].set_xlabel('t-SNE Dimension 1', fontsize=12)
        axes[1].set_ylabel('t-SNE Dimension 2', fontsize=12)
        axes[1].legend(handles=legend_elements, loc='best')
        
    except Exception as e:
        axes[1].text(0.5, 0.5, f't-SNE failed: {str(e)[:50]}...', 
                    ha='center', va='center')
        axes[1].set_title('t-SNE Visualization (Failed)', fontsize=14, fontweight='bold')
        print(f"t-SNE Error: {e}")
    
    plt.suptitle('Dimensionality Reduction Visualizations', fontsize=16, fontweight='bold')
    plt.tight_layout()
    plt.show()



