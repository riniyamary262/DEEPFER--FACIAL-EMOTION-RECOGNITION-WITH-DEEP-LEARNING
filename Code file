def plot_image_statistics(X):
    """
    Analyze and visualize image statistics
    """
    if len(X) == 0:
        print("No images available for statistics")
        return
    
    fig, axes = plt.subplots(2, 3, figsize=(18, 10))
    axes = axes.flatten()
    
    # 3.1 Pixel Intensity Distribution
    axes[0].hist(X.flatten(), bins=50, color='steelblue', alpha=0.7, edgecolor='black')
    axes[0].set_title('Pixel Intensity Distribution', fontsize=14, fontweight='bold')
    axes[0].set_xlabel('Pixel Intensity', fontsize=12)
    axes[0].set_ylabel('Frequency', fontsize=12)
    axes[0].axvline(np.mean(X), color='red', linestyle='--', label=f'Mean: {np.mean(X):.3f}')
    axes[0].axvline(np.median(X), color='green', linestyle='--', label=f'Median: {np.median(X):.3f}')
    axes[0].legend()
    
    # 3.2 Image Mean Values
    image_means = np.mean(X.reshape(len(X), -1), axis=1)
    axes[1].hist(image_means, bins=30, color='coral', alpha=0.7, edgecolor='black')
    axes[1].set_title('Distribution of Image Mean Values', fontsize=14, fontweight='bold')
    axes[1].set_xlabel('Mean Pixel Value', fontsize=12)
    axes[1].set_ylabel('Number of Images', fontsize=12)
    axes[1].axvline(np.mean(image_means), color='red', linestyle='--', 
                   label=f'Mean: {np.mean(image_means):.3f}')
    axes[1].legend()
    
    # 3.3 Image Standard Deviation
    image_stds = np.std(X.reshape(len(X), -1), axis=1)
    axes[2].hist(image_stds, bins=30, color='lightgreen', alpha=0.7, edgecolor='black')
    axes[2].set_title('Distribution of Image Standard Deviation', fontsize=14, fontweight='bold')
    axes[2].set_xlabel('Standard Deviation', fontsize=12)
    axes[2].set_ylabel('Number of Images', fontsize=12)
    axes[2].axvline(np.mean(image_stds), color='red', linestyle='--', 
                   label=f'Mean: {np.mean(image_stds):.3f}')
    axes[2].legend()
    
    # 3.4 Image Contrast (Range)
    image_ranges = np.max(X.reshape(len(X), -1), axis=1) - np.min(X.reshape(len(X), -1), axis=1)
    axes[3].hist(image_ranges, bins=30, color='plum', alpha=0.7, edgecolor='black')
    axes[3].set_title('Distribution of Image Contrast (Range)', fontsize=14, fontweight='bold')
    axes[3].set_xlabel('Intensity Range', fontsize=12)
    axes[3].set_ylabel('Number of Images', fontsize=12)
    axes[3].axvline(np.mean(image_ranges), color='red', linestyle='--', 
                   label=f'Mean: {np.mean(image_ranges):.3f}')
    axes[3].legend()
    
    # 3.5 Image Entropy (Complexity)
    try:
        from scipy.stats import entropy
        image_entropy = []
        for i in range(min(1000, len(X))):
            hist, _ = np.histogram(X[i].flatten(), bins=20, range=(0, 1))
            hist = hist / hist.sum()
            image_entropy.append(entropy(hist))
        
        axes[4].hist(image_entropy, bins=20, color='gold', alpha=0.7, edgecolor='black')
        axes[4].set_title('Image Complexity (Entropy)', fontsize=14, fontweight='bold')
        axes[4].set_xlabel('Entropy', fontsize=12)
        axes[4].set_ylabel('Number of Images', fontsize=12)
        axes[4].axvline(np.mean(image_entropy), color='red', linestyle='--', 
                       label=f'Mean: {np.mean(image_entropy):.3f}')
        axes[4].legend()
    except:
        axes[4].text(0.5, 0.5, 'Entropy calculation not available', ha='center', va='center')
        axes[4].set_title('Image Complexity', fontsize=14, fontweight='bold')
    
    # 3.6 Heatmap of Average Image
    avg_image = np.mean(X, axis=0).reshape(48, 48)
    im = axes[5].imshow(avg_image, cmap='gray')
    axes[5].set_title('Average Image (All Classes)', fontsize=14, fontweight='bold')
    axes[5].axis('off')
    plt.colorbar(im, ax=axes[5], fraction=0.046, pad=0.04)
    
    plt.suptitle('Image Statistics and Properties', fontsize=16, fontweight='bold')
    plt.tight_layout()
    plt.show()
    
    # Print statistics
    print("\n" + "="*60)
    print("IMAGE STATISTICS")
    print("="*60)
    print(f"Image Shape: {X.shape[1:]} (Height x Width x Channels)")
    print(f"Total Pixels per Image: {X.shape[1] * X.shape[2]}")
    print(f"Mean Pixel Intensity: {np.mean(X):.4f}")
    print(f"Standard Deviation: {np.std(X):.4f}")
    print(f"Min Pixel Intensity: {np.min(X):.4f}")
    print(f"Max Pixel Intensity: {np.max(X):.4f}")


